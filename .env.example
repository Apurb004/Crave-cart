# CraveCart Environment Configuration Template
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key for session signing and CSRF tokens (Replace in production!)
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# SQLite Database URI (defaults to instance/cravecart.db if not specified)
DATABASE_URL=sqlite:///cravecart.db

# Upload Configuration
MAX_CONTENT_LENGTH=5242880  # 5MB in bytes
UPLOAD_FOLDER=app/static/images/uploads
